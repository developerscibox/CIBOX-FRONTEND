# URL del API en PRODUCCIÓN. Expo carga este archivo en builds de producción
# (expo export) y tiene precedencia sobre .env. Así los builds locales también
# quedan correctos. En Vercel, además, la variable EXPO_PUBLIC_API_URL del
# proyecto manda. El .env (localhost) queda solo para desarrollo local.
EXPO_PUBLIC_API_URL=https://api.cibox.cl/api
