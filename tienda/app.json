{
  "expo": {
    "name": "Cibox",
    "slug": "cibox-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3E7D1E"
    },
    "scheme": "cibox",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.cibox.app"
    },
    "android": {
      "package": "cl.cibox.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3E7D1E"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3E7D1E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2cd33dc1-3ac6-47c5-a492-4fec8572d82b"
      }
    }
  }
}
