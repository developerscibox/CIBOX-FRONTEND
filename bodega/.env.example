# URL del backend de Cibox (el mismo backend de la tienda).
# El panel consume /api/inventory (kardex, ajustes, stock crítico, búsqueda por
# código de barras) y /api/orders (preparación de pedidos).
VITE_API_URL=http://localhost:3001/api

# Token de un usuario admin/bodega para las llamadas autenticadas.
# (Fase siguiente: login propio con el authService del backend en vez de token fijo.)
VITE_API_TOKEN=
