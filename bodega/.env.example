# URL del backend Bodega 12 (mismo backend de la tienda).
# El panel consume /api/inventory (kardex, ajustes, stock crítico, picking por barcode)
# y /api/orders (para el picking de pedidos en preparación).
VITE_API_URL=http://localhost:3001/api

# Token de un usuario admin/bodega para las llamadas autenticadas.
# (Fase siguiente: login propio con el authService del backend en vez de token fijo.)
VITE_API_TOKEN=
